    { "input": "5\n1", "output": "false" },
    { "input": "1000000000\n10", "output": "true" },
    { "input": "100\n100", "output": "true" },
    { "input": "2\n2", "output": "true" },
    { "input": "3\n9", "output": "false" },
    { "input": "64\n4", "output": "true" }
  ],
