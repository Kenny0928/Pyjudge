  "description": "<p class='problem-lead'>取出一個字串的第一個字元。</p><p>請讀取字串 <code>a</code>，輸出它的第一個字元。<code>a</code> 保證至少有一個字元，且不含前導或尾端空白。</p>",
  "hint": "<p>字串的第一個字元可以用索引 <code>0</code> 取得，例如 <code>a[0]</code>。</p>",
  "inputFormat": "<p>一行，包含字串 <code>a</code>。</p>",
  "outputFormat": "<p>一行，輸出 <code>a</code> 的第一個字元。</p>",
  "constraints": "<ul><li>1 ≤ a 的字元數 ≤ 100</li><li>a 不含前導或尾端空白字元</li></ul>",
  "timeLimit": 1,
  "memoryLimit": 256,
  "sampleInput": "apple",
  "sampleOutput": "a",
  "samples": [
    { "input": "apple", "output": "a" },
    { "input": "Cat", "output": "C" },
    { "input": "z", "output": "z" }
  ],
  "testCases": [
    { "input": "apple", "output": "a" },
    { "input": "Cat", "output": "C" },
    { "input": "z", "output": "z" },
    { "input": "Hello World", "output": "H" },
    { "input": "1234567890", "output": "1" },
    { "input": "!@#$%^&*", "output": "!" },
    { "input": "程式設計", "output": "程" },
    { "input": "Python", "output": "P" },
    { "input": "AAAAA", "output": "A" },
    { "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "output": "x" }
  ],
