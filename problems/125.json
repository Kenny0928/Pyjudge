  "prerequisites": ["清單索引", "切片運算"],
  "description": "<p class='problem-lead'>從一份固定的清單中擷取出指定範圍的子清單。</p><p>固定清單為 <code>[1, 2, 3, 4, 5]</code>（索引由 0 開始）。請讀取起始索引 <code>m</code> 與結束索引 <code>n</code>，輸出清單中索引 <code>m</code>（含）到索引 <code>n</code>（<b>不含</b>）之間的所有元素。若擷取範圍內沒有任何元素，輸出空白行。</p>",
  "hint": "<p>Python 的切片 <code>list[m:n]</code> 天生就是「含 m、不含 n」的區間，直接使用即可。</p>",
  "inputFormat": "<p>第一行為整數 <code>m</code>；第二行為整數 <code>n</code>。</p>",
  "outputFormat": "<p>輸出擷取到的子清單元素，以空白分隔排在同一行；若子清單為空則輸出空白行。</p>",
  "constraints": "<ul><li>0 ≤ m ≤ n ≤ 5</li></ul>",
  "timeLimit": 1,
  "memoryLimit": 256,
  "sampleInput": "1\n4",
  "sampleOutput": "2 3 4",
  "samples": [
    { "input": "1\n4", "output": "2 3 4" },
    { "input": "0\n2", "output": "1 2" },
    { "input": "0\n0", "output": "" }
  ],
  "testCases": [
    { "input": "0\n0", "output": "" },
    { "input": "0\n5", "output": "1 2 3 4 5" },
    { "input": "1\n4", "output": "2 3 4" },
    { "input": "0\n2", "output": "1 2" },
    { "input": "4\n5", "output": "5" },
    { "input": "2\n2", "output": "" },
    { "input": "5\n5", "output": "" },
    { "input": "3\n5", "output": "4 5" },
    { "input": "0\n1", "output": "1" },
    { "input": "2\n5", "output": "3 4 5" }
  ],
