  "description": "<p class='problem-lead'>判斷一個字串結尾是否為驚嘆號。</p><p>讀取字串 <code>a</code>，判斷它是否以 <code>!</code>（驚嘆號）結尾。是則輸出小寫 <code>true</code>，否則輸出小寫 <code>false</code>。若字串為空字串，視為不以驚嘆號結尾。</p>",
  "hint": "<p>Python 字串有直接判斷結尾的方法，可以比較最後一個字元是否相符。</p>",
  "inputFormat": "<p>一行，包含字串 <code>a</code>，字串可能為空。</p>",
  "outputFormat": "<p>若 <code>a</code> 以 <code>!</code> 結尾，輸出 <code>true</code>；否則輸出 <code>false</code>。</p>",
  "constraints": "<ul><li>0 ≤ a 的字元數 ≤ 100</li></ul>",
  "timeLimit": 1,
  "memoryLimit": 256,
  "sampleInput": "Wow!",
  "sampleOutput": "true",
  "samples": [
    { "input": "Wow!", "output": "true" },
    { "input": "Wow?", "output": "false" },
    { "input": "!", "output": "true" }
  ],
  "testCases": [
    { "input": "Wow!", "output": "true" },
    { "input": "Wow?", "output": "false" },
    { "input": "!", "output": "true" },
    { "input": "", "output": "false" },
    { "input": "Hello World!", "output": "true" },
    { "input": "Hello!World", "output": "false" },
    { "input": "!!!", "output": "true" },
    { "input": "Wow! ", "output": "false" },
    { "input": "123!", "output": "true" },
    { "input": "abc", "output": "false" }
  ],
