    { "input": "4\n0 0 0 0", "output": "" },
    { "input": "5\n-1 -2 -3 -4 -5", "output": "-1 -2 -3 -4 -5" },
    { "input": "6\n-3 2 -1 0 7 -5", "output": "-3 -1 -5" },
    { "input": "8\n1 -1 2 -2 3 -3 4 -4", "output": "-1 -2 -3 -4" },
    { "input": "2\n-1000 1000", "output": "-1000" }
