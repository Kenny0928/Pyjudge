    { "input": "5\n1 1 1 1 1\n2 9", "output": "1 1 1 1 1\n1 1 9 1 1" },
    { "input": "4\n10 20 30 40\n0 -1", "output": "10 20 30 40\n-1 20 30 40" },
    { "input": "4\n10 20 30 40\n3 -1", "output": "10 20 30 40\n10 20 30 -1" },
    { "input": "2\n7 8\n1 0", "output": "7 8\n7 0" },
    { "input": "6\n1 2 3 4 5 6\n5 999", "output": "1 2 3 4 5 6\n1 2 3 4 5 999" },
    { "input": "3\n-5 -10 -15\n0 100", "output": "-5 -10 -15\n100 -10 -15" },
    { "input": "1\n0\n0 1", "output": "0\n1" }
  ],
